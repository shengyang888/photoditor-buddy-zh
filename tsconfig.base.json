{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@photoditor-buddy/core": ["./packages/core/src/index.ts"],
      "@photoditor-buddy/core/*": ["./packages/core/src/*"],
      "@photoditor-buddy/ai": ["./packages/ai/src/index.ts"],
      "@photoditor-buddy/ai/*": ["./packages/ai/src/*"],
      "@photoditor-buddy/ui": ["./packages/ui/src/index.ts"],
      "@photoditor-buddy/ui/*": ["./packages/ui/src/*"],
      "@photoditor-buddy/sdk": ["./packages/sdk/src/index.ts"]
    }
  }
}
