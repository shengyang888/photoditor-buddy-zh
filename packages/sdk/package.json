{
  "name": "@photoditor-buddy/sdk",
  "version": "0.1.0",
  "description": "Embed photoditor-buddy into any website with one script tag or one npm import.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/photoditor-buddy-sdk.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/photoditor-buddy-sdk.js",
      "default": "./dist/photoditor-buddy-sdk.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build"
  },
  "devDependencies": {
    "vite": "^8.3.0"
  },
  "module": "./dist/photoditor-buddy-sdk.js",
  "unpkg": "./dist/photoditor-buddy-sdk.iife.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/alwaysnelson/photoditor-buddy.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "photo-editor",
    "image-editor",
    "embed",
    "sdk",
    "ai"
  ]
}
